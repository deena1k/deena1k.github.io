var linkedln = document.getElementById("link");
var selection = document.getElementById("project_subset");
var maximize = document.getElementById("project-select");


selection.addEventListener("mouseover",expand)
selection.addEventListener("mouseout",discard)

linkedln.addEventListener("click",redirect);

function expand()
{
    maximize.setAttribute("style","visibility:visible")
}

function discard()
{
    maximize.setAttribute("style","visibility:hidden")    
}

function redirect()
{
    window.open("https://www.linkedin.com/in/adeena-khan/");
}
